{%- set L = htmlLang | default('fr') -%}
{%- set t = i18n[L].landing -%}
<!doctype html>
<html lang="{{ L }}">
<head>
{% include "partials/head.njk" %}
{%- if jsonldBlocks %}
<script type="application/ld+json">{{ jsonldBlocks | safe }}</script>
{%- endif %}
</head>
<body class="esgim">
<a class="skip" href="#contenu">{{ i18n[L].skip }}</a>

<header class="esgim-head">
  <div class="wrap bar">
    <a class="brand" href="/{{ L }}/" aria-label="{{ t.brand_label }}">
      <img src="/assets/img/esgim-logo-blanc.png" alt="ESG Interim Management" width="150" height="32" decoding="async">
    </a>
    <div class="bar-right">
      {%- if altUrls and (altUrls | length) > 1 %}
      <nav class="langs" aria-label="{{ i18n[L].other_langs }}">
        {%- for l in site.langs %}
          {%- if l == L %}
        <span aria-current="true">{{ l | upper }}</span>
          {%- elif altUrls[l] %}
        <a href="{{ altUrls[l] }}" hreflang="{{ l }}" lang="{{ l }}">{{ l | upper }}</a>
          {%- endif %}
        {%- endfor %}
      </nav>
      {%- endif %}
    </div>
  </div>
</header>

<main id="contenu">
{{ content | safe }}
</main>

<footer class="esgim-foot">
  <div class="wrap">
    <div class="cols">
      <img src="/assets/img/esgim-logo-blanc.png" alt="ESG Interim Management" width="131" height="28" decoding="async">
      <p class="links">
        <a href="/{{ L }}/">{{ t.home }}</a>
        <a href="/{{ L }}/{{ kb.branches.hub[L] }}/">{{ t.catalogue }}</a>
        <a href="{{ site.aboutUrl }}">{{ t.who }}</a>
        <a href="{{ t.legal_url }}">{{ t.legal }}</a>
      </p>
    </div>
    {%- if altUrls and (altUrls | length) > 1 %}
    <nav class="langs" aria-label="{{ i18n[L].other_langs }}">
      {%- for l in site.langs %}
        {%- if l == L %}
      <span aria-current="true">{{ l | upper }}</span>
        {%- elif altUrls[l] %}
      <a href="{{ altUrls[l] }}" hreflang="{{ l }}" lang="{{ l }}">{{ l | upper }}</a>
        {%- endif %}
      {%- endfor %}
    </nav>
    {%- endif %}
    {% include "partials/mentions.njk" %}
  </div>
</footer>

{% include "partials/consentement.njk" %}
<script src="/assets/js/landing.js" defer></script>
<script src="/assets/js/tracking.js" defer></script>
{%- if tarifs %}
<script src="/assets/js/tarifs.js" defer></script>
{%- endif %}
</body>
</html>
