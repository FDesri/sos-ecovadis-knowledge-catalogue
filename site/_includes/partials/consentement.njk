{#- Bandeau de consentement : ÉCRIT, INERTE. Il reste caché tant que
    site/assets/js/tracking.js porte ACTIF = false (étape 5).
    Texte dans la langue de la page, depuis i18n[lang].landing. -#}
{%- set cl = htmlLang | default('fr') -%}
{%- set ct = i18n[cl].landing -%}
<div class="consent" id="consentement" role="dialog" aria-live="polite"
     aria-label="{{ ct.consent_label }}" hidden>
  <div class="wrap inner">
    <p>{{ ct.consent_text }}
    <a href="{{ ct.legal_url }}">{{ ct.consent_link }}</a>.</p>
    <div class="acts">
      <button type="button" class="ok" data-consent="oui">{{ ct.consent_yes }}</button>
      <button type="button" data-consent="non">{{ ct.consent_no }}</button>
    </div>
  </div>
</div>
