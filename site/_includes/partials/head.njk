<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · {{ site.name }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta name="robots" content="{{ robots | default('index, follow, max-snippet:-1, max-image-preview:large') }}">
{%- for l, href in altUrls %}
<link rel="alternate" hreflang="{{ l }}" href="{{ site.url }}{{ href }}">
{%- endfor %}
{%- set xdefault = altUrls.fr or altUrls.en or altUrls.nl %}
{%- if xdefault %}
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ xdefault }}">
{%- endif %}
<meta property="og:type" content="{{ ogType | default('article') }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:locale" content="{{ htmlLang }}">
{#- Image de partage : une par langue. Les fiches trilingues (lang mul)
    retombent sur le français, langue par défaut du plan d'URL. #}
{%- set ogLang = htmlLang if htmlLang == "fr" or htmlLang == "nl" or htmlLang == "en" else "fr" %}
<meta property="og:image" content="{{ site.url }}/assets/img/og-{{ ogLang }}.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ title }} — {{ site.publisher }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.url }}/assets/img/og-{{ ogLang }}.jpg">
<meta name="author" content="{{ site.author }}">
<link rel="icon" href="/assets/img/favicon.png" type="image/png">
<link rel="stylesheet" href="/assets/css/main.css">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="{{ site.url }}/feed.xml">
